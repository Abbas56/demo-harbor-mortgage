---
interface Step { label: string; detail: string; }
interface Props { steps: Step[]; }
const { steps } = Astro.props;
---
<div class="stepper">
  {steps.map((s, i) => (
    <div class="stepper__step">
      <div class="stepper__num">{i + 1}</div>
      <p><strong>{s.label}</strong><br />{s.detail}</p>
    </div>
  ))}
</div>
